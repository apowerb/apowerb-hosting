# Copy this file to `.env`, then run `./scripts/generate-secrets.sh` to fill
# ENCRYPT_KEY and the service tokens with random values.

# --- Database --------------------------------------------------------------
DB_NAME=th2agent
DB_USER=th2agent
DB_PASSWORD=change-me
# The Postgres of this stack does no TLS and does not need any: the traffic
# stays inside the internal Docker network. Against a managed database (Neon,
# RDS, OVH), set this to `require`.
DB_SSLMODE=disable

# --- Secrets ---------------------------------------------------------------
# ENCRYPT_KEY must be a valid Fernet key (32 bytes in url-safe base64). The
# OAuth tokens of the integrations are encrypted with it: the server refuses to
# start without one, and an empty key would make forged tokens acceptable.
# WARNING: changing it makes every already connected integration unreadable.
ENCRYPT_KEY=

# --- Network ---------------------------------------------------------------
TH2AGENT_PORT=8000
FRONT_PORT=3000
# The address the BROWSER will use to reach the API. Locally, the port
# published above; behind a reverse proxy, the public URL.
PUBLIC_API_URL=http://localhost:8000
# For the VM + HTTPS setup, the public domain served by Traefik.
APP_HOST=app.example.com
ACME_EMAIL=admin@example.com

# --- Published images ------------------------------------------------------
# The two tags are a PAIR and move together, in both directions: the frontend
# needs routes the older backends do not serve, and a newer backend can drop a
# route an older frontend still calls. Leave them as shipped unless you know
# which pair you are moving to; `latest` on either side breaks the pairing.
APOWERB_BACKEND_IMAGE=apowerb/apowerb
APOWERB_BACKEND_TAG=0.2.8
APOWERB_FRONTEND_IMAGE=apowerb/apowerb-ui
APOWERB_FRONTEND_TAG=0.1.13

# --- Shared model ----------------------------------------------------------
# Offers one model to every agent, on your key, under the id `thaink2/default`.
# Both the model and the key must be set, otherwise the provider is not offered
# at all -- silently -- and each agent has to carry its own key.
# The model id follows the LiteLLM naming, e.g. `gemini/gemini-2.5-flash`.
DEFAULT_LLM_MODEL=
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_API_BASE=

# --- System mailer ---------------------------------------------------------
# Off unless configured. NOTIFICATION_INTEGRATION_OWNER is the account, in the
# database, that owns the mailbox integration used to send system email;
# SUPER_ADMIN_EMAIL receives the ETL and system alerts. Leave them empty and no
# system email is sent at all -- no error, no alert.
NOTIFICATION_EMAIL=
NOTIFICATION_INTEGRATION_OWNER=
SUPER_ADMIN_EMAIL=

# --- First administrator ----------------------------------------------------
# Not the same thing as SUPER_ADMIN_EMAIL above: that one receives alerts,
# this one designates who *is* an administrator. On a new database nobody is,
# and no route grants it -- so without this a fresh install has no admin, and
# the Logging screen, which is administrators only, stays empty for everyone.
#
# The e-mail alone is the whole configuration: whoever signs up with that
# address is created ADMIN, with their own password. The password below only
# creates the account up front, before anyone registers; leave it empty
# otherwise. Neither has a default -- a shipped default password is a
# published one.
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=

# ===========================================================================
# OPTIONAL SERVICES
#
# Two, one profile each, both off. Turn them on by listing their profiles in
# COMPOSE_PROFILES -- comma-separated for both:
#
#   COMPOSE_PROFILES=pulse
#   COMPOSE_PROFILES=etl
#   COMPOSE_PROFILES=pulse,etl
#
# COMPOSE_PROFILES is read from your SHELL first and from this file second, so
# a stale `export COMPOSE_PROFILES=...` left over from another project turns
# services on while the lines here stay commented. `docker compose config
# --services` says which services a run will actually create -- ask it rather
# than reading this file, when the two could disagree.
#
# Neither profile is enough on its own: each needs one more line below, and
# the profile without it runs a service nobody talks to.
#
# ONE line, whichever you want -- a second COMPOSE_PROFILES= further down
# silently replaces the first.
#COMPOSE_PROFILES=pulse,etl
# ===========================================================================

# --- Optional: logs and agent traces (profile `pulse`) ---------------------
# A collector and the th2pulse ingest, storing agent traces -- tool executions
# with their arguments and responses, LLM calls, durations -- in their own
# schema of the Postgres above.
#
# The profile AND the endpoint. The profile alone runs an ingest nobody writes
# to; the endpoint alone leaves the application retrying an exporter with
# nowhere to send.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# The ingest binds 0.0.0.0 in its container, so these are not optional
# hardening -- it refuses to start without them, and `/spans` serves recorded
# tool arguments and responses. `./scripts/generate-secrets.sh` fills them.
TH2PULSE_INGEST_TOKEN=
TH2PULSE_QUERY_TOKEN=

# --- Optional: orchestration (profile `etl`) -------------------------------
# th2etl, so scheduled agent runs actually fire. Without it the backend
# defaults to ORCHESTRATOR=mage, this stack ships no Mage, and the
# Orchestrator screen answers 503 "Mage is unreachable" -- a truthful answer
# and still a broken screen for anyone self-hosting.
#
# The profile AND this line, plus the key below. A Compose environment cannot
# depend on a profile, so the backend has to be told separately which
# orchestrator to address: the profile alone runs an orchestrator nobody
# calls, and ORCHESTRATOR alone points the backend at a service that is not
# there.
#ORCHESTRATOR=th2etl

# Required whenever the profile is on. An empty value does not open th2etl,
# it CLOSES it: every business route is refused with "Authentication not
# configured". The backend must send the same value, and does -- both read
# this one line. `./scripts/generate-secrets.sh` fills it.
TH2ETL_API_KEY=

# --- Edition ---------------------------------------------------------------
# Empty = open-source edition. Commercial bricks are declared here, separated
# by commas, and must be installed in the image.
TH2_EXTENSIONS=

WORKING_MODE=development
