# Copy this file to `.env`, then run `./scripts/generate-secrets.sh` to fill
# ENCRYPT_KEY with a random value.

# --- Database --------------------------------------------------------------
DB_NAME=th2agent
DB_USER=th2agent
DB_PASSWORD=change-me
# The Postgres of this stack does no TLS and does not need any: the traffic
# stays inside the internal Docker network. Against a managed database (Neon,
# RDS, OVH), set this to `require`.
DB_SSLMODE=disable

# --- Secrets ---------------------------------------------------------------
# ENCRYPT_KEY must be a valid Fernet key (32 bytes in url-safe base64). The
# OAuth tokens of the integrations are encrypted with it: the server refuses to
# start without one, and an empty key would make forged tokens acceptable.
# WARNING: changing it makes every already connected integration unreadable.
ENCRYPT_KEY=

# --- Network ---------------------------------------------------------------
TH2AGENT_PORT=8000
FRONT_PORT=3000
# The address the BROWSER will use to reach the API. Locally, the port
# published above; behind a reverse proxy, the public URL.
PUBLIC_API_URL=http://localhost:8000
# For the VM + HTTPS setup, the public domain served by Traefik.
APP_HOST=app.example.com
ACME_EMAIL=admin@example.com

# --- Published images ------------------------------------------------------
# The two tags are a PAIR and move together, in both directions: the frontend
# needs routes the older backends do not serve, and a newer backend can drop a
# route an older frontend still calls. Leave them as shipped unless you know
# which pair you are moving to; `latest` on either side breaks the pairing.
APOWERB_BACKEND_IMAGE=apowerb/apowerb
APOWERB_BACKEND_TAG=0.2.8
APOWERB_FRONTEND_IMAGE=apowerb/apowerb-ui
APOWERB_FRONTEND_TAG=0.1.12

# --- Shared model ----------------------------------------------------------
# Offers one model to every agent, on your key, under the id `thaink2/default`.
# Both the model and the key must be set, otherwise the provider is not offered
# at all -- silently -- and each agent has to carry its own key.
# The model id follows the LiteLLM naming, e.g. `gemini/gemini-2.5-flash`.
DEFAULT_LLM_MODEL=
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_API_BASE=

# --- System mailer ---------------------------------------------------------
# Off unless configured. NOTIFICATION_INTEGRATION_OWNER is the account, in the
# database, that owns the mailbox integration used to send system email;
# SUPER_ADMIN_EMAIL receives the ETL and system alerts. Leave them empty and no
# system email is sent at all -- no error, no alert.
NOTIFICATION_EMAIL=
NOTIFICATION_INTEGRATION_OWNER=
SUPER_ADMIN_EMAIL=

# --- Logs and agent traces (optional) --------------------------------------
# Off by default. Uncomment BOTH lines to deploy the observability stack: a
# collector and the th2pulse ingest, storing agent traces -- tool executions
# with their arguments and responses, LLM calls, durations -- in their own
# schema of the Postgres above.
#
# One line without the other is the failure worth avoiding: the profile alone
# runs an ingest nobody writes to, and the endpoint alone leaves the
# application retrying an exporter with nowhere to send.
#COMPOSE_PROFILES=logs
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# COMPOSE_PROFILES is read from your shell first and from this file second,
# so a stale `export COMPOSE_PROFILES=logs` left over from another project
# turns these services on while the line above stays commented -- an ingest
# running with nothing writing to it. `docker compose config --services`
# says which services a run will actually create.

# The ingest binds 0.0.0.0 in its container, so these are not optional
# hardening -- it refuses to start without them, and `/spans` serves recorded
# tool arguments and responses. `./scripts/generate-secrets.sh` fills them.
TH2PULSE_INGEST_TOKEN=
TH2PULSE_QUERY_TOKEN=

# --- Edition ---------------------------------------------------------------
# Empty = open-source edition. Commercial bricks are declared here, separated
# by commas, and must be installed in the image.
TH2_EXTENSIONS=

WORKING_MODE=development
