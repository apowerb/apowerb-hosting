# Copiez ce fichier en `.env`, puis lancez `./scripts/generate-secrets.sh`
# pour remplir TEST_TOKEN et ENCRYPT_KEY avec des valeurs aleatoires.

# --- Base de donnees -------------------------------------------------------
DB_NAME=th2agent
DB_USER=th2agent
DB_PASSWORD=changez-moi
# Le Postgres de cette pile ne fait pas de TLS et n'en a pas besoin : le
# trafic reste dans le reseau interne de Docker. Contre une base geree
# (Neon, RDS, OVH), mettez `require`.
DB_SSLMODE=disable

# --- Secrets ---------------------------------------------------------------
# ENCRYPT_KEY doit etre une cle Fernet valide (32 octets en base64 url-safe).
# Les jetons OAuth des integrations sont chiffres avec : le serveur refuse de
# demarrer si elle manque, et une cle vide ferait accepter des jetons forges.
# ATTENTION : la changer rend illisibles toutes les integrations deja connectees.
ENCRYPT_KEY=
TEST_TOKEN=

# --- Reseau ----------------------------------------------------------------
TH2AGENT_PORT=8000
FRONT_PORT=3000
# Adresse a laquelle le NAVIGATEUR joindra l'API. En local, l'adresse publiee
# ci-dessus ; derriere un reverse proxy, l'URL publique.
PUBLIC_API_URL=http://localhost:8000
# Pour le mode VM/SSH + HTTPS, renseignez le domaine public expose par Traefik.
APP_HOST=app.example.com
ACME_EMAIL=admin@example.com

# --- Images publiees -------------------------------------------------------
APOWERB_BACKEND_IMAGE=apowerb/apowerb
APOWERB_BACKEND_TAG=latest
APOWERB_FRONTEND_IMAGE=apowerb/apowerb-ui
APOWERB_FRONTEND_TAG=latest

# --- Edition ---------------------------------------------------------------
# Vide = edition open source. Les briques commerciales se declarent ici,
# separees par des virgules, et doivent etre installees dans l'image.
TH2_EXTENSIONS=

WORKING_MODE=development
