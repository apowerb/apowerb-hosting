    "publicUrls": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "appPublicUrl": {
          "type": [
            "string",
            "number"
          ],
          "description": "L'origine du FRONT, sans chemin ni slash final : https://apowerb.example."
        },
        "publicBaseUrl": {
          "type": [
            "string",
            "number"
          ],
          "description": "L'origine de l'API, que les webhooks Microsoft et Google composent. Vide, elle suit `appPublicUrl` : l'ingress route tout vers le front, qui relaie `/api`. Le code ajoute `/api/...` lui-meme -- une origine, pas un chemin."
        }
      },
      "description": "Ou cette installation repond, en public. Le coeur deduit de `appPublicUrl` tout ce qu'un navigateur doit atteindre : origines CORS, callbacks GitHub, Google et Outlook Mail. Une seule valeur pour neuf reglages -- a condition qu'elle ne soit PAS vide : une variable posee vide compte comme fournie et remplace le defaut au lieu de s'effacer devant lui. C'est pourquoi rien ici n'est emis tant que…"
    },
    "defaultLlm": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model": {
          "type": [
            "string",
            "number"
          ]
        },
        "apiKey": {
          "type": [
            "string",
            "number"
          ]
        },
        "apiBase": {
          "type": [
            "string",
            "number"
          ],
          "description": "Point d'entree compatible OpenAI, pour un fournisseur tiers ou local."
        }
      },
      "description": "Modele offert par defaut aux agents, sans que l'utilisateur pose sa cle. Sans lui, chacun doit apporter la sienne pour faire tourner un agent."
    },
    "integrations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "microsoft": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "clientId": {
              "type": [
                "string",
                "number"
              ]
            },
            "clientSecret": {
              "type": [
                "string",
                "number"
              ]
            },
            "tenantId": {
              "type": [
                "string",
                "number"
              ],
              "description": "`common` accepte tous les tenants ; mettez le votre pour le restreindre."
            },
            "redirectUri": {
              "type": [
                "string",
                "number"
              ],
              "description": "Jamais deduite, volontairement : le coeur laisse ce champ vide plutot que de pointer ailleurs, pour qu'un vide se lise « pas configure »."
            },
            "outlookMailRedirectUri": {
              "type": [
                "string",
                "number"
              ],
              "description": "Callback d'Outlook Mail, distinct du precedent. Vide, le coeur le deduit de l'URL publique : `<origine>/emailing/microsoft/callback`."
            }
          }
        },
        "google": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "clientId": {
              "type": [
                "string",
                "number"
              ]
            },
            "clientSecret": {
              "type": [
                "string",
                "number"
              ]
            },
            "redirectUri": {
              "type": [
                "string",
                "number"
              ],
              "description": "Vide, deduit : `<origine>/integrations/google/callback`."
            },
            "webhookAudience": {
              "type": [
                "string",
                "number"
              ],
              "description": "Reclamee seulement par les webhooks Google."
            }
          }
        }
      },
      "description": "Connexions tierces. Chacune se declare aussi cote fournisseur, et l'URI de redirection doit y correspondre au caractere pres. ⚠️ `microsoft.*` ici, ce sont les INTEGRATIONS (Outlook, OneDrive, Teams). La famille MICROSOFT_* sans _INTEGRATION sert a la connexion des utilisateurs : deux jeux d'identifiants distincts, aux noms voisins."
    },
